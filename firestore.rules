rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    match /folders/{folderId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
